#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
# The bundle owns the executable name, so read it from Info.plist instead of
# embedding it: a renamed product must not break the installed command.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
app=$(CDPATH= cd -- "$resources/.." && pwd -P)
executable=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$app/Info.plist")
ELECTRON_RUN_AS_NODE=1 exec "$app/MacOS/$executable" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
